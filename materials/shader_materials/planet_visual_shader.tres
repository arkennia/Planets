[sub_resource type="VisualShaderNodeGlobalExpression" id="VisualShaderNodeGlobalExpression_odnc4"]
size = Vector2(440, 300)
expression = "vec4 GetColor(float height, float m) {
	if (height < 0.06)
        return DeepWater;
    if (height < .2)
        return Water;
    if (height < .27)
        return Desert;

    if (height > 0.7)
    {
        if (m < 0.1) return Savannah;
        if (m < 0.2) return MountainSide;
        return m < 0.6 ? Tundra : Snow;
    }

    if (height > 0.6)
    {
        if (m < 0.33) return Desert;
        return m < 0.66 ? Grassland : Forest;
    }

    if (height > 0.4)
    {
        if (m < 0.2) return Desert;
        if (m < 0.4) return Grassland;
        if (m < 0.83) return Jungle;
    }

    if (m < 0.16) return Savannah;
    return m < 0.33 ? Grassland : Jungle;

}"

