code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;


// Varyings
varying vec3 var_tex_pos;

uniform sampler2D heightMap;
uniform sampler2D tex_frg_4 : hint_normal;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// FloatConstant:8
	float n_out8p0 = 2.000000;


// FloatConstant:9
	float n_out9p0 = 0.500000;


// MultiplyAdd:4
	vec3 n_out4p0 = fma(n_out2p0, vec3(n_out8p0), vec3(n_out9p0));


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(heightMap, vec2(n_out4p0.xy));


// Output:0
	COLOR.rgb = vec3(n_out11p0.xyz);


// VaryingSetter:15
	var_tex_pos = n_out4p0;


}

void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;


// Texture2D:4
	vec4 n_out4p0 = texture(tex_frg_4, UV);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	NORMAL = vec3(n_out4p0.xyz);


}
