code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;


// Varyings
varying vec3 var_tex_coord;

uniform sampler3D tex3d_frg_12;



void vertex() {
	var_tex_coord = vec3(0.0);
}

void fragment() {
// Input:14
	vec2 n_out14p0 = UV;


	vec3 n_out13p0;
// Expression:13
	n_out13p0 = vec3(0.0, 0.0, 0.0);
	{
		float theta = n_out14p0.y * 3.14159;
		float phi = n_out14p0.x * 3.14159 * 2.0;
		vec3 n_out13p0 = vec3(0.0, 0.0, 0.0);
		
		n_out13p0.x = sin(phi) * sin(theta);
		n_out13p0.y = cos(theta) * -1.0;
		n_out13p0.z = cos(phi) * sin(theta);
		n_out13p0 = normalize(n_out13p0);
	}


	vec4 n_out12p0;
// Texture3D:12
	n_out12p0 = texture(tex3d_frg_12, n_out13p0);


// Output:0
	ALBEDO = vec3(n_out12p0.xyz);


}
