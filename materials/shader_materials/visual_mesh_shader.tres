code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;


// Varyings
varying vec2 var_uv;

uniform sampler2D NoiseTexture : source_color;



void vertex() {
// Input:6
	vec3 n_out6p0 = VERTEX;


	vec2 n_out5p0;
// Expression:5
	n_out5p0 = vec2(0.0, 0.0);
	{
		n_out6p0 = normalize(n_out6p0);
		n_out5p0.x = 0.5 + atan(n_out6p0.z,n_out6p0.x)/ (PI * 2.0);
		n_out5p0.y = 0.5 + asin(n_out6p0.y)/PI;
		// n_out5p0 *= 5.0;
	}


	vec4 n_out9p0;
// Texture2D:9
	n_out9p0 = texture(NoiseTexture, n_out5p0);


// Output:0
	COLOR.rgb = vec3(n_out9p0.xyz);


	var_uv = vec2(0.0);
}

void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);


}
"
